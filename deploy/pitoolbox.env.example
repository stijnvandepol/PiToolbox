# pitoolbox - omgevingsvariabelen voor de systemd-service (EnvironmentFile=).
# Installeren als /etc/pitoolbox/pitoolbox.env (install.sh doet dat als het nog niet bestaat):
#   sudo install -o pitoolbox -g pitoolbox -m 0600 pitoolbox.env.example /etc/pitoolbox/pitoolbox.env
#
# BEVEILIGING: dit bestand moet chmod 600 zijn en eigendom van pitoolbox. Later komen hier ook
# LLM-API-sleutels in. Nooit committen (staat in .gitignore als *.env).
# Formaat (man systemd.exec, EnvironmentFile=): KEY=waarde, een per regel, '#' = commentaar,
# GEEN `export`, geen shell-expansie (dus geen $HOME of ~; gebruik absolute paden).
# De variabelen komen uit src/pitoolbox/config.py (Settings.from_env).

# --- Fase 2: remote -----------------------------------------------------------------------------
# VERPLICHT voor --transport http. Publieke basis-URL achter de tunnel: zonder pad, zonder slash
# aan het eind. De MCP-resource is dan <PUBLIC_URL>/mcp. Moet exact de hostnaam zijn uit
# deploy/cloudflared/config.yml, anders weigert de server de Host-header.
# VERVANG toolbox.example.nl door je eigen (sub)domein.
PITOOLBOX_PUBLIC_URL=https://toolbox.example.nl

# Alleen loopback! De server weigert te starten op een ander adres. De tunnel is de enige ingang.
PITOOLBOX_HTTP_HOST=127.0.0.1
# Moet overeenkomen met `service:` in /etc/cloudflared/pitoolbox.yml.
PITOOLBOX_HTTP_PORT=8765

# SQLite met wachtwoord-hash, TOTP-geheim, geregistreerde clients en tokens. Moet in
# /var/lib/pitoolbox liggen (daar mag de service schrijven, ReadWritePaths=).
PITOOLBOX_AUTH_DB=/var/lib/pitoolbox/auth.sqlite

# Levensduur van tokens in seconden. Standaard: access 900 (15 min); refresh 604800 (7 dagen,
# met rotatie). Alleen aanpassen als je weet waarom. (De levensduur van de autorisatiecode, 300 s,
# is niet via een variabele in te stellen.)
#PITOOLBOX_ACCESS_TOKEN_TTL_S=900
#PITOOLBOX_REFRESH_TOKEN_TTL_S=604800

# Standaard accepteert de OAuth-server ALLEEN de Claude-callbacks (claude.ai / claude.com).
# Alleen tijdelijk, om met de MCP Inspector te testen, extra exacte redirect-URI's toestaan
# (kommagescheiden). Daarna weer leegmaken en `pitoolbox-auth revoke-all` draaien.
#PITOOLBOX_EXTRA_REDIRECT_URIS=http://127.0.0.1:6274/oauth/callback

# --- Fase 1: apparaten, scope, opslag -----------------------------------------------------------
# Scope (welke BSSID's/IR-bestanden mogen). Root-eigendom, 0640 root:pitoolbox, zodat de service
# zijn eigen scope niet kan wijzigen. Wordt live herladen; ongeldig of weg = lege scope (fail closed).
PITOOLBOX_SCOPE_FILE=/etc/pitoolbox/scope.yaml

# Audit-log: een JSON-regel per toolcall. deploy/logrotate/pitoolbox roteert precies dit pad;
# pas dat bestand mee aan als je dit wijzigt.
PITOOLBOX_AUDIT_LOG=/var/lib/pitoolbox/audit.jsonl

# pcap-captures van capture_start komen in <dir>/<sessie>/.
PITOOLBOX_CAPTURES_DIR=/var/lib/pitoolbox/captures

# Seriele poort van de Flipper. Leeg of weglaten = automatisch zoeken op USB 0483:5740.
#PITOOLBOX_FLIPPER_PORT=/dev/ttyACM0

# Flipper-CLI-profiel: auto (op basis van firmware_origin_fork) of een vast profiel, nu: official.
#PITOOLBOX_FLIPPER_CLI_PROFILE=auto

# --- Fase 3: Flipper over Bluetooth LE (zie docs/fase3-ble.md) ---------------------------------
# Welk transport voor de Flipper: auto (eerst USB, anders BLE), usb of ble. Over BLE werken alleen de
# RPC-tools (system_info, storage_*, ir_send); subghz_rx, nfc_read en rfid_read hebben USB nodig.
#PITOOLBOX_FLIPPER_TRANSPORT=auto

# BLE-adres van de gekoppelde Flipper (aanbevolen: vast adres i.p.v. zoeken op naam). Koppelen en
# het adres vinden: `pitoolbox-flipper ble-scan` en `pitoolbox-flipper ble-pair <adres>`, dat de
# juiste regel afdrukt. De koppeling zit in bluetoothd (systeembreed, niet per gebruiker): je kunt
# hem doen met elke gebruiker in de groep 'bluetooth'; de service (gebruiker pitoolbox, ook in die
# groep) gebruikt hem daarna. Leeg = zoeken op naamprefix (trager en minder voorspelbaar).
#PITOOLBOX_FLIPPER_BLE_ADDRESS=AA:BB:CC:DD:EE:FF

# Naamprefix waarmee Flippers bij het zoeken worden herkend ("Flipper <naam>").
#PITOOLBOX_FLIPPER_BLE_NAME_PREFIX=Flipper

# Elke zoveel seconden een RPC-ping als de BLE-verbinding niet gebruikt wordt, zodat hij niet
# wegvalt; 0 = uit. Alleen relevant voor BLE.
#PITOOLBOX_FLIPPER_KEEPALIVE_S=20

# Netwerkinterfaces: de Alfa (monitor/scan) en de uplink (nooit omzetten!).
PITOOLBOX_ALFA_IFACE=wlan1
PITOOLBOX_UPLINK_IFACE=wlan0
# Verwachte driver van de Alfa; wifi-acties weigeren als wlan1 een andere driver heeft
# (bescherming tegen verwisselde namen). Leeg = controle uit.
#PITOOLBOX_ALFA_DRIVER=mt7921u

# --- Fase 4: LLM-provider (geen standaard; de agent weigert te starten zonder) ----------------
# openai-compatible | anthropic | openai
#PITOOLBOX_LLM_PROVIDER=
#PITOOLBOX_LLM_MODEL=
# Verplicht bij openai-compatible, bijv. http://127.0.0.1:11434/v1 (Ollama). http:// alleen naar
# localhost of een privé-LAN-IP.
#PITOOLBOX_LLM_BASE_URL=
# GEHEIM. Dit bestand moet daarom 0600 en eigendom van pitoolbox zijn.
#PITOOLBOX_LLM_API_KEY=

# Geldigheid (s) van een openstaande transmit-bevestiging (pending_id).
#PITOOLBOX_CONFIRM_TTL_S=60

# Kommagescheiden lijst van toegestane tools; leeg = alle tools. Bijv. voor een eerste test
# met alleen lezen: status,system_info,wifi_scan
#PITOOLBOX_TOOL_ALLOWLIST=

# --- Later (fase 4): LLM-providers --------------------------------------------------------------
# Hier komen straks API-sleutels; daarom chmod 600.
